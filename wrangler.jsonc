/**
 * Moneyhi11s 2026 storefront + revenue analytics worker
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "50cent-rich",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "my-workflow",
      "binding": "MY_WORKFLOW",
      "class_name": "MyWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKFLOW_STATUS",
        "class_name": "WorkflowStatusDO"
      },
      {
        "name": "REVENUE_STATS",
        "class_name": "RevenueStatsDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkflowStatusDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RevenueStatsDO"]
    }
  ],
  "upload_source_maps": true
}
